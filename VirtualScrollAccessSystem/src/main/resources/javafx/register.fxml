<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="400" prefWidth="300" spacing="10" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="javafx.controller.RegisterController">

    <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Register" />

    <TextField fx:id="usernameField" maxWidth="200" promptText="Username" />
    <PasswordField fx:id="passwordField" maxWidth="200" promptText="Password" />
    <TextField fx:id="emailField" maxWidth="200" promptText="Email" />
    <TextField fx:id="phoneField" maxWidth="200" promptText="Phone Number" />

    <Button maxWidth="200" onAction="#handleRegister" style="-fx-background-color: #97ff80;" text="Register">
      <font>
         <Font name="System Bold" size="13.0" />
      </font></Button>

    <Button maxWidth="200" onAction="#handleBack" style="-fx-background-color: #f54242;" text="Back to Login">
      <font>
         <Font name="System Bold" size="13.0" />
      </font></Button>

    <Label fx:id="errorMessageLabel" style="-fx-text-fill: red;" text="" />
</VBox>
