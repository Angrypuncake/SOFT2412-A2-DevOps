<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="javafx.controller.RegisterController" alignment="CENTER" spacing="10" prefHeight="400" prefWidth="300">

    <Label text="Register" style="-fx-font-size: 20px; -fx-font-weight: bold;" />

    <TextField fx:id="usernameField" promptText="Username" maxWidth="200"/>
    <PasswordField fx:id="passwordField" promptText="Password" maxWidth="200"/>
    <TextField fx:id="emailField" promptText="Email" maxWidth="200"/>
    <TextField fx:id="phoneField" promptText="Phone Number" maxWidth="200"/>

    <Button text="Register" onAction="#handleRegister" maxWidth="200"/>

    <Button text="Back to Login" onAction="#handleBack" maxWidth="200"/>

    <Label fx:id="errorMessageLabel" text="" style="-fx-text-fill: red;"/>
</VBox>
