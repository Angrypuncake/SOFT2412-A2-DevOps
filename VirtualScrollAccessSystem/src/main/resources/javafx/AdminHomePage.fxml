<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="javafx.controller.HomePageController" alignment="CENTER" spacing="10" prefWidth="400" prefHeight="300">

    <!-- Admin-specific content -->
    <Label text="Welcome, Admin!" style="-fx-font-size: 24px; -fx-font-weight: bold;" />

    <!-- Scroll Management Button -->
    <Button mnemonicParsing="false" onAction="#handleScrollManagement" prefHeight="120.0" prefWidth="200.0" text="Scroll Management" />
    <!-- Scroll Finder Button -->
    <Button layoutY="120.0" mnemonicParsing="false" onAction="#handleScrollFinder" prefHeight="120.0" prefWidth="200.0" text="Scroll Finder" />
    <!-- Profile Button -->
    <Button layoutY="240.0" mnemonicParsing="false" onAction="#handleProfile" prefHeight="120.0" prefWidth="200.0" text="Profile" />
    <!-- Logout Button -->
    <Button layoutY="480.0" mnemonicParsing="false" onAction="#handleLogout" prefHeight="120.0" prefWidth="200.0" text="Logout" />

    <!-- User Management Button -->
    <Button layoutY="360.0" mnemonicParsing="false" onAction="#handleUserManagement" prefHeight="120.0" prefWidth="200.0" text="User Management" />

</VBox>
