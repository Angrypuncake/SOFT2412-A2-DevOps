<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="javafx.controller.HomePageController" alignment="CENTER" spacing="10" prefWidth="400" prefHeight="300">

    <!-- Admin-specific content -->
    <Label text="Welcome, Admin!" style="-fx-font-size: 24px; -fx-font-weight: bold;" />

    <!-- Admin-specific features -->
    <Button text="Manage Users" onAction="#handleManageUsers" />
    <Button text="System Settings" onAction="#handleSystemSettings" />

    <!-- Logout button -->
    <Button text="Logout" onAction="#handleLogout" />

</VBox>
