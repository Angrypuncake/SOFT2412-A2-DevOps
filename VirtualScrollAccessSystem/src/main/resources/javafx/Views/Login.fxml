<?xml version="1.0" encoding="UTF-8"?>

<?import com.gluonhq.charm.glisten.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <!-- Email Field -->
      <TextField fx:id="emailFieldLogin" layoutX="49.0" layoutY="86.0" promptText="email@example.com" />
      <!-- Remember me Checkbox -->
      <CheckBox layoutX="46.0" layoutY="237.0" mnemonicParsing="false" onAction="#handleRememberMe" text="Remember me" />
      <!-- Sign in Button -->
      <Button layoutX="52.0" layoutY="286.0" mnemonicParsing="false" onAction="#handleSignIn" prefHeight="48.0" prefWidth="86.0" style="-fx-background-color: blue;" text="Sign in" textFill="WHITE" />
      <!-- Password Field -->
      <PasswordField fx:id="passwordFieldLogin" layoutX="49.0" layoutY="182.0" promptText="Password" />
      <!-- "Email address" title text -->
      <Text layoutX="49.0" layoutY="73.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Email Address">
         <font>
            <Font size="15.0" />
         </font>
      </Text>
      <!-- "Password" title text -->
      <Text layoutX="49.0" layoutY="167.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Password">
         <font>
            <Font size="15.0" />
         </font>
      </Text>
      <!-- Line for decoration -->
      <Line endX="383.0" endY="-45.5" layoutX="417.0" layoutY="406.0" startX="-417.0" startY="-45.5" />
      <!-- Sign up Button -->
      <Button layoutX="22.0" layoutY="376.0" mnemonicParsing="false" onAction="#handleSignUp" prefHeight="25.0" prefWidth="203.0" style="-fx-background-color: light-gray;" text="New around here? Sign up">
         <font>
            <Font size="15.0" />
         </font>
      </Button>
      <!-- Forgot Password Button -->
      <Button layoutX="10.0" layoutY="439.0" mnemonicParsing="false" onAction="#handleForgotPassword" prefHeight="31.0" prefWidth="172.0" style="-fx-background-color: light-gray;" text="Forgot password?">
         <font>
            <Font size="15.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
