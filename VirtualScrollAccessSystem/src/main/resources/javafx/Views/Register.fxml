<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="javafx.controller.UserController"
      alignment="CENTER" spacing="10" prefHeight="400" prefWidth="300">

    <!-- Title -->
    <Text text="Register" style="-fx-font-size: 20px; -fx-font-weight: bold;" />

    <!-- Username Field -->
    <TextField fx:id="usernameField" promptText="Username" maxWidth="200"/>

    <!-- Password Field -->
    <PasswordField fx:id="passwordField" promptText="Password" maxWidth="200"/>

    <!-- Email Field -->
    <TextField fx:id="emailField" promptText="Email" maxWidth="200"/>

    <!-- Phone Number Field -->
    <TextField fx:id="phoneField" promptText="Phone Number" maxWidth="200"/>

    <!-- Register Button -->
    <Button text="Register" onAction="#handleRegister" maxWidth="200"/>

    <!-- Error Message Label -->
    <Label fx:id="errorMessageLabel" text="" style="-fx-text-fill: red;"/>

    <!-- Styling -->
    <padding>
        <Insets top="20" bottom="20" left="20" right="20"/>
    </padding>
</VBox>
