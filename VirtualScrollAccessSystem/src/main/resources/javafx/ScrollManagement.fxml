<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" spacing="10" style="-fx-pref-height: 800; -fx-pref-width: 600;" stylesheets="@css/example.css" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="javafx.controller.ScrollManagementController">
    <Button fx:id="adminShadow" mnemonicParsing="false" onAction="#handleAdminShadow" text="Admin">
        <VBox.margin>
            <Insets left="-550.0" top="-60.0" />
        </VBox.margin>
    </Button>
    <Button fx:id="normalShadow" mnemonicParsing="false" onAction="#handleNormalShadow" text="Normal">
        <VBox.margin>
            <Insets left="-420.0" top="-36.0" />
        </VBox.margin>
    </Button>
    <Button fx:id="guestShadow" mnemonicParsing="false" onAction="#handleGuestShadow" text="Guest">
        <VBox.margin>
            <Insets left="-300.0" top="-36.0" />
        </VBox.margin>
    </Button>

    <Label text="Manage Your Scrolls">
        <font>
            <Font size="50.0" />
        </font>
    </Label>

    <!-- Button to select and upload a file -->
    <Button onAction="#chooseFile" text="Select File to Upload" />

    <!-- TableView for displaying the user's own scrolls -->
    <TextField fx:id="searchField" alignment="TOP_LEFT" promptText="Search scrolls by name" style="-fx-max-width: 400;" />
    <TableView fx:id="scrollTable" prefHeight="400.0" prefWidth="600.0" style="-fx-pref-width: 600; -fx-pref-height: 200;">
        <columns>
            <TableColumn fx:id="idColumn" prefWidth="150.0" text="Scroll ID" />
            <TableColumn fx:id="nameColumn" prefWidth="150.0" text="Scroll Name" />
            <TableColumn fx:id="uploaderColumn" prefWidth="150.0" text="Uploader Username" />
            <TableColumn fx:id="uploadDate" prefWidth="150.0" text="Date Uploaded" />
        </columns>
      <columnResizePolicy>
         <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
      </columnResizePolicy>
    </TableView>

    <Button onAction="#handleDeleteScroll" prefHeight="25.0" prefWidth="226.0" text="Delete Selected Scroll" />

    <HBox alignment="CENTER" spacing="10">
        <Label alignment="CENTER" text="Scroll Name" />
        <TextField fx:id="scrollNameField" />
    </HBox>

    <HBox alignment="CENTER" spacing="10">
        <Button alignment="TOP_CENTER" onAction="#handleUpdateScroll" prefHeight="25.0" prefWidth="223.0" text="Rename Scroll" />
    </HBox>

    <TextArea fx:id="scrollContentTextArea" layoutX="100" layoutY="300" prefHeight="160" prefWidth="400" wrapText="true" />
    <Button fx:id="saveContentButton" layoutX="520" layoutY="510" onAction="#handleSaveScrollContent" text="Update and save content" />


    <Button onAction="#BackHome" prefHeight="25.0" prefWidth="226.0" text="Home">
        <graphic>
            <ImageView>
                <image>
                    <Image url="@Images/castle.png" />
                </image>

            </ImageView>
        </graphic>
    </Button>

</VBox>
