<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="600.0" stylesheets="@css/example.css" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="javafx.controller.ScrollStatsController">
    <children>
        <Button layoutX="543.0" layoutY="0" mnemonicParsing="false" onAction="#handleLogout" prefHeight="26.0" prefWidth="55.0" text="Logout" />
        <Button layoutX="483.0" layoutY="0" mnemonicParsing="false" onAction="#handleHome" prefHeight="26.0" prefWidth="55.0" text="Home" />
        <!-- TableView for displaying ScrollStats -->
        <TableView fx:id="scrollTableView" layoutX="50.0" layoutY="100.0" prefHeight="500.0" prefWidth="500.0">
            <columns>
                <TableColumn fx:id="nameColumn" prefWidth="200.0" text="Scroll Name" />
                <TableColumn fx:id="uploadCountColumn" prefWidth="100.0" text="Uploads" />
                <TableColumn fx:id="downloadCountColumn" prefWidth="100.0" text="Downloads" />
            </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
        </TableView>

        <!-- Labels to display detailed information -->
        <Label fx:id="uploaderLabel" layoutX="50.0" layoutY="620.0" text="Uploader: " />
        <Label fx:id="orphanedLabel" layoutX="50.0" layoutY="650.0" text="Status: " />
        <Label alignment="CENTER" layoutX="132.0" layoutY="15.0" text="Scroll Stats" textAlignment="CENTER">
            <font>
                <Font name="Arial Black" size="36.0" />
            </font>
        </Label>
        <!-- ToggleButton to hide/show inactive scrolls -->
        <ToggleButton fx:id="toggleInactiveButton" layoutX="50.0" layoutY="70.0" onAction="#toggleInactiveScrolls" text="Show Inactive Scrolls" />

        <Button fx:id="updateButton" layoutX="485.0" layoutY="700.0" mnemonicParsing="false" onAction="#handleUpdateScrollStats" text="Update" />
        <Button fx:id="deleteButton" layoutX="543.0" layoutY="700.0" mnemonicParsing="false" onAction="#handleDeleteScrollStats" text="Delete" />

        <!-- Button to toggle orphaned state -->
        <Button fx:id="toggleOrphanedButton" layoutX="50.0" layoutY="700.0" mnemonicParsing="false" onAction="#handleToggleOrphaned" text="Toggle Active Status" />

        <Button layoutX="543.0" layoutY="772.0" mnemonicParsing="false" onAction="#handleLogout" text="Logout" />
        <Button layoutX="485.0" layoutY="772.0" mnemonicParsing="false" onAction="#handleHome" prefHeight="26.0" prefWidth="55.0" text="Home" />

    </children>
</AnchorPane>
